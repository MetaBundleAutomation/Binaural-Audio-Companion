# replace with your own site name
NEXT_PUBLIC_SITE_NAME=""

# replace with your own title
NEXT_PUBLIC_TITLE=""

# replace with your own description
NEXT_PUBLIC_DESCRIPTION=""

# replace with your own URL, e.g https://example.com
NEXT_PUBLIC_URL=""

# The room (live chat) and the live numbers on the About page.
# From the Supabase dashboard: Project Settings → API. Leave both empty to
# ship without them; the app then hides the room and the live numbers.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Where the "Support CRUX" button on the About page goes (Ko-fi, Buy Me a
# Coffee, Stripe payment link, PayPal…). Leave empty to hide the button.
NEXT_PUBLIC_DONATE_URL=""

# Ask CRUX, AI mode. With a key set, the guide on /ask sends each question to
# Claude (Anthropic) to choose from the library. Leave it empty and the guide
# still works: it matches the words on the device and sends nothing anywhere.
# Server-side only: never prefix this with NEXT_PUBLIC_. Set a monthly spend
# limit on the Anthropic account before turning it on.
ANTHROPIC_API_KEY=""

# <optional> if you want to use Google Analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="<your-google-analytics-id>"
